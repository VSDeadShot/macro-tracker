# Copy to .env and replace every value. All values below are fake placeholders — never commit real ones.

# Prisma runtime connection (src/lib/prisma.ts) — Supabase transaction pooler, port 6543
DATABASE_URL="postgresql://your-db-user:your-db-password@your-pooler-host:6543/postgres?pgbouncer=true"

# Prisma CLI / migrations (prisma.config.ts) — session pooler or direct connection, port 5432
DIRECT_URL="postgresql://your-db-user:your-db-password@your-pooler-host:5432/postgres"

# Supabase Auth (middleware, server/browser clients, keep-alive ping) — exposed to the browser
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Gemini Vision (src/app/api/analyze/route.ts) — server-only
GEMINI_API_KEY="your-gemini-api-key"

# Protects /api/keepalive (Vercel Cron). Vercel sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET="your-random-cron-secret"
